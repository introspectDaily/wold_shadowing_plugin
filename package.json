{
  "name": "word-shadowing",
  "description": "单词跟读 - 标准发音、跟读录音、回放、标记与记忆管理",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/introspectDaily/wold_shadowing_plugin.git"
  },
  "homepage": "https://github.com/introspectDaily/wold_shadowing_plugin#readme",
  "bugs": {
    "url": "https://github.com/introspectDaily/wold_shadowing_plugin/issues"
  },
  "scripts": {
    "dev": "wxt --mode development",
    "dev:firefox": "wxt -b firefox --mode development",
    "build": "wxt build --mode production",
    "build:dev": "wxt build --mode development",
    "build:firefox": "wxt build -b firefox --mode production",
    "zip": "wxt zip --mode production",
    "zip:firefox": "wxt zip -b firefox --mode production",
    "zip:all": "pnpm zip && pnpm zip:firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "verify": "pnpm compile && pnpm test",
    "postinstall": "wxt prepare",
    "icons": "node scripts/generate-icons.mjs",
    "canvas:shot": "node scripts/canvas-shot.mjs",
    "fetch:model": "node scripts/fetch-layout-model.mjs"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "onnxruntime-web": "^1.31.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@wxt-dev/module-react": "^1.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.11",
    "wxt": "^0.21.4"
  }
}
